---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import { site } from "../config/site";
import { getNext } from "../lib/workshops";

const entries = await getCollection("workshops");
const next = getNext(
  entries.map((entry) => entry.data),
  site.timeZone,
);
---

<Base title={`${site.brand} // HOME`} description={site.tagline}>
  <section class="hero panel">
    <div class="prompt">WELCOME, USER.</div>
    <h1>CREATE. DESTROY. REBUILD.</h1>
    <p class="lede">{site.tagline}</p>
    <div class="command-row">
      <a class="button" href="/workshops/">[ WORKSHOPS ]</a>
      <a class="button" href="/repair/">[ REPAIR DESK ]</a>
    </div>
  </section>

  <section class="grid two">
    <article class="panel">
      <div class="panel-title">&gt; NEXT WORKSHOP</div>
      {
        next ? (
          <WorkshopCard workshop={next} />
        ) : (
          <p class="muted">NO UPCOMING WORKSHOPS SCHEDULED.</p>
        )
      }
      <a class="text-link" href="/workshops/"> VIEW SCHEDULE &gt;&gt; </a>
    </article>
    <article class="panel">
      <div class="panel-title">&gt; REPAIR DESK</div>
      <p>
        Give me your broken, your glitchy, your "too expensive."
      </p>
      <p class="muted">
        Visit my desk in the back of the 3d studios to drop off your broken things for a no-cost repair- just look for the neon signs.
      </p>
      <a class="button full" href="/repair/"> [ BOOK A REPAIR APPOINTMENT ] </a>
    </article>
  </section>

  <section class="panel">
    <div class="panel-title">{site.aboutHeading}</div>
    <div class="grid two">
      <p>{site.aboutPrimary}</p>
      <p class="muted">{site.aboutSecondary}</p>
    </div>
  </section>
</Base>
