---
import Base from "../layouts/Base.astro";
import RepairForm from "../components/RepairForm.astro";
import { site } from "../config/site";
---

<Base
  title={`REPAIR DESK // ${site.brand}`}
  description="Request a repair appointment."
>
  <section class="panel">
    <div class="prompt">&gt; REPAIR.DESK</div>
    <h1>NEW REPAIR REQUEST</h1>
    <p class="muted">Fill out a ticket here describing your issue, and leave your item in my cave at the back of the 3d studios. I'll get back to you ASAP with next steps.</p>
    <RepairForm />
  </section>
</Base>
