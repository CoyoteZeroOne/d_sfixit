---
import { FORM_ENDPOINTS, FORM_SUBJECTS } from "../config/forms";
import { site } from "../config/site";
import {
  isFormsConfigured,
  isSignupViaWorker,
  turnstileSiteKey,
} from "../lib/env";
import Honeypot from "./Honeypot.astro";
import Web3Fields from "./Web3Fields.astro";
import FormUnavailable from "./FormUnavailable.astro";
import type { Workshop } from "../lib/workshops";

interface Props {
  workshop: Workshop;
}

const { workshop } = Astro.props;
---

{
  isSignupViaWorker || isFormsConfigured ? (
    <form
      class="terminal-form"
      data-signup-form
      method="POST"
      action={
        isSignupViaWorker ? FORM_ENDPOINTS.signupWorker : FORM_ENDPOINTS.signup
      }
    >
      <input type="hidden" name="workshop_id" value={workshop.id} />
      <input type="hidden" name="workshop_title" value={workshop.title} />

      <label for="name">YOUR NAME</label>
      <input id="name" name="name" required placeholder="> type here" />

      <label for="email">EMAIL</label>
      <input
        id="email"
        type="email"
        name="email"
        required
        placeholder="> name@example.com"
      />

      <label for="notes">ANYTHING WE SHOULD KNOW?</label>
      <textarea id="notes" name="notes" rows={3} placeholder="> optional" />

      {isSignupViaWorker ? (
        <>
          <Honeypot />
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
          />
          <noscript>
            <p class="muted">
              Signing up here needs JavaScript for the bot check. Email{" "}
              {site.contactEmail} to sign up instead.
            </p>
          </noscript>
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          />
        </>
      ) : (
        <Web3Fields
          subject={`${FORM_SUBJECTS.signup}: ${workshop.title}`}
          redirectPath={`/thanks/?w=${workshop.id}`}
        />
      )}

      <button class="button full" type="submit">
        [ SIGN UP ]
      </button>
    </form>
  ) : (
    <FormUnavailable />
  )
}

<script>
  // Stops a double click sending the signup twice. With the Worker, the second
  // request would also fail the bot check, since a Turnstile token works once.
  const buttons = () =>
    document.querySelectorAll<HTMLButtonElement>(
      "form[data-signup-form] button[type=submit]",
    );
  for (const form of document.querySelectorAll("form[data-signup-form]")) {
    form.addEventListener("submit", () => {
      for (const button of buttons()) button.disabled = true;
    });
  }
  // The Back button can restore the page with the button still disabled.
  window.addEventListener("pageshow", () => {
    for (const button of buttons()) button.disabled = false;
  });
</script>
