# eslint-plugin-jsx-a11y@6.10.2 hasn't published an ESLint 10 peer range yet, even
# though it works fine with it (it's a pure rules plugin with no dependency on
# ESLint internals that changed between 9 and 10). Remove this once jsx-a11y
# ships a release whose peerDependencies include "^10.0.0".
legacy-peer-deps=true
