# Get a free access key at https://web3forms.com (no login required, just an email).
# Without this set, the site still builds — forms show an "offline" notice instead.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# Signup emails (see "Signup emails" in the README). Signups switch from Web3Forms
# to this site's Worker only when both of these are set.
PUBLIC_SIGNUP_VIA_WORKER=false
PUBLIC_TURNSTILE_SITE_KEY=
